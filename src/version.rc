#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION FIX_VERSION_NUMBERS
 PRODUCTVERSION FIX_VERSION_NUMBERS
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "github.com/ChronoRixun/xml2-fix"
            VALUE "FileDescription", "X-Men Legends II controller and online fix (DirectInput proxy)"
            VALUE "FileVersion", FIX_VERSION
            VALUE "InternalName", "dinput"
            VALUE "LegalCopyright", "MIT License"
            VALUE "OriginalFilename", "dinput.dll"
            VALUE "ProductName", "XML2 Fix"
            VALUE "ProductVersion", FIX_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
